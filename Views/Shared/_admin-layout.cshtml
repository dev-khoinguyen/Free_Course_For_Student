<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-LEARNING Trải Nghiệm Công Nghệ</title>
    <link rel="stylesheet" href="/common/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="/common/lib/slider/owl.carousel.min.css" />
    <link rel="stylesheet" href="/common/lib/slider/owl.theme.default.min.css" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/common/css/homepage.css" />
</head>

<body>


    <section class="header-section">
        @await Component.InvokeAsync("LoginStatus")

        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid wrap-navbar">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item active">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="UserManagement">Quản lí người dùng</a>
                        </li>
                         <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="CourseManagement">Quản lí khóa học</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="SubmissionManagement">Quản lí bài nộp</a>
                        </li>

                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <header class="header-content">
            <div class="logo"></div>
            <div class="form-wrap">
                <form class="search-container" role="search">
                    <label for="search-input" class="visually-hidden">Tìm kiếm thông
                        tin</label>
                    <input type="search" id="search-input" class="search-input" placeholder="Tìm kiếm thông tin"
                        aria-label="Tìm kiếm thông tin">
                    <button type="submit" class="search-button">
                        <img src="/common/images/search-logo.png" alt="Search" class="search-icon">
                    </button>
                </form>
                <div class="bell-logo"></div>
            </div>

        </header>
    </section>
    <!---------------- body render ------------ -->
    @RenderBody()
    <!---------------- footer ------------ -->
    <footer class="footer mt-5">
        <div class="container footer-content py-4">
            <div class="row">
                <!-- Contact Column -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="contact-info">
                        <h2 class="title-footer">Liên Hệ</h2>
                        <p class="contact-detail">(+84)076 291 5213</p>
                        <p class="contact-detail">Gmail: E-learning@gmail.com</p>
                        <p class="contact-detail">Địa chỉ: <a
                                href="https://elearning-dmaweyhnfmgxeyf6.southeastasia-01.azurewebsites.net"
                                target="_blank">Truy cập</a></p>
                    </div>
                </div>

                <!-- Products Column -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <h2 class="title-footer">Sản phẩm</h2>
                </div>

                <!-- Newsletter Column -->
                <div class="col-lg-4 col-md-12">
                    <h2 class="title-footer">Nhận thông tin định kì</h2>
                    <section class="registration-container d-flex align-items-center justify-content-between p-2">
                        <button class="registration-button btn btn-primary">Đăng kí</button>
                    </section>
                    <div class="logo-footer mt-3"></div>
                </div>
            </div>
        </div>
        <p class="copyright text-center">&copy; 2024 ............................</p>
    </footer>


    <script src="/common/lib/jquery/jquery-3.6.0.min.js"></script>
    <script src="/common/lib/bootstrap/bootstrap.min.js"></script>
    <script src="/common/lib/slider/owl.carousel.min.js"></script>
    <script src="/common/js/main.js" asp-append-version="true"></script>

</body>

</html>