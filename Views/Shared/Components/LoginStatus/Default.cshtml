@model string

@if (!string.IsNullOrEmpty(Model))
{
    <div class="profile-icon d-flex align-items-center ms-auto">
        <a class="profile-img-link" asp-controller="Home" asp-action="Information">
            <span class="profile-name">
                <i class="material-icons profile-icon-google">person</i> Xin chào, @Model!
            </span>
        </a>
        <a href="/home/logout" class="btn btn-danger btn-sm logout-btn">
            <i class="material-icons">logout</i> Đăng xuất
        </a>
    </div>


}
else
{
    <div class="top-decorations">
        <div class="decoration-line"></div>
        <a class="" asp-controller="Home" asp-action="Login">Đăng nhập</a>
        <div class="decoration-line"></div>
        <a class="" asp-controller="Home" asp-action="Register">Đăng kí</a>
    </div>
}
