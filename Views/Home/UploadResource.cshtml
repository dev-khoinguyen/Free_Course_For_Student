@model Course
@{
    ViewData["Title"] = "UploadResource";
    Layout = "/Views/Shared/_homepage-layout.cshtml";
}
<div class="container-upload">
    <div class="text-center">
        <span class="material-icons icon-upload d-block mx-auto">cloud_upload</span>
    </div>

    <div class="container mt-5">
        <h2 class="mb-4">Thêm Khóa Học</h2>
        <form asp-action="UploadResource" asp-controller="Home" method="post">
            <div class="mb-4">
                <label for="title" class="form-label">Tiêu đề</label>
                <input type="text" class="form-control" id="title" name="Title" asp-for="Title" placeholder="Nhập tiêu đề khóa học" required>
            </div>
            <div class="mb-4">
                <label for="description" class="form-label">Mô tả</label>
                <textarea class="form-control" id="description" name="Description" asp-for="Description" rows="3" placeholder="Nhập mô tả khóa học"></textarea>
            </div>
            <div class="mb-4">
                <label for="link_doc" class="form-label">Link Tài Liệu</label>
                <input type="url" class="form-control" id="link_doc" name="LinkDoc" asp-for="LinkDoc" placeholder="Nhập link tài liệu">
            </div>
            <div class="mb-4">
                <label for="link_video" class="form-label">Link Video</label>
                <input type="url" class="form-control" id="link_video" name="LinkVideo" asp-for="LinkVideo" placeholder="Nhập link video">
            </div>
            <button type="submit" class="btn btn-primary">Thêm Khóa Học</button>
        </form>
    </div>
</div>