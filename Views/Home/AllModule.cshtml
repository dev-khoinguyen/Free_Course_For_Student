@model List<EXE_PROJECT.Models.Module>

@{
    ViewData["Title"] = "AllModule";
    Layout = "/Views/Shared/_homepage-layout.cshtml";
}

<div class="container module-container--cl-module">
    <h2 class="text-center mb-4">Danh sách Modules</h2>

    @if (Model != null && Model.Any())
    {
        foreach (var module in Model)
        {
    <div class="module-card--cl-module">
        <h5 class="module-title--cl-module">Module @module.Position: @module.Title</h5>
        <p class="module-description--cl-module">
            @Html.Raw(!string.IsNullOrEmpty(module.Description) && module.Description.Length > 100
                        ? module.Description.Substring(0, 100) + "..."
                        : module.Description)
        </p>

        <a href="/Home/ModuleInformation/@module.ModuleId" class="btn btn-primary module-btn--cl-module">Xem chi
            tiết</a>
    </div>
        }
    }
    else
    {
        <p class="text-center text-muted">Chưa có module nào!! Cần Đăng ký đủ số lượng để mở Module!!</p>
    }
</div>
