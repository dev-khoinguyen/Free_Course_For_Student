@{
    ViewData["Title"] = "LeaningMaterials";
    Layout = "/Views/Shared/_homepage-layout.cshtml";
}
@model List<EXE_PROJECT.Models.Course>

<h2 class="material-title">Các Khóa Học</a></h2>
<div class="container learning-wrapper">


    <div class="slider-container">
        <div class="slider-wrapper">
            @if (Model != null && Model.Any())
            {
                foreach (var course in Model)
                {
                    <div class="slider-item">
                        <a asp-controller="Home" asp-action="CourseInformation" asp-route-id="@course.Id" text-decoration="none">
                            <img src="https://ununsplash.imgix.net/photo-1431578500526-4d9613015464?fit=crop&fm=jpg&h=300&q=75&w=400"
                                alt="Course Image">
                            <p>@course.Description</p>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="slider-item">
                    <img src="https://ununsplash.imgix.net/photo-1431578500526-4d9613015464?fit=crop&fm=jpg&h=300&q=75&w=400"
                        alt="Placeholder Image">
                    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
                </div>
            }
        </div>

        <div class="button-container">
            <button id="prev" class="button-learning">&lt;</button>
            <button id="next" class="button-learning">&gt;</button>
        </div>
    </div>


    <h2 class="material-inside-title">Thẻ học liệu dành cho bạn</h2>
    <div class="container material-for-you-wrapper">
        <div class="row">
            <div class="col-lg-4">
                <article class="learning-card">
                    <div class="card-content">
                        <img src="https://cdn.builder.io/api/v1/image/assets/TEMP/5efdb3fc97a77f3e64de5f99bed465e16524949a979e8549bc861b1359500d53?placeholderIfAbsent=true&apiKey=9353569a3a3e4b28bd8525400308d314"
                            alt="" class="card-icon" />
                        <div class="card-details">
                            <h2 class="card-title">Kỹ Thuật Phần Mềm</h2>
                            <div class="card-meta">
                                <div class="meta-item">
                                    <img src="https://cdn.builder.io/api/v1/image/assets/TEMP/10362e98450ec4e19b25c772a7aeda2bec76be0b1add1d3e7ef67bcee9279854?placeholderIfAbsent=true&apiKey=9353569a3a3e4b28bd8525400308d314"
                                        alt="" class="meta-icon" />
                                    <span>Có sẵn</span>
                                </div>
                                <div class="meta-item">
                                    <img src="https://cdn.builder.io/api/v1/image/assets/TEMP/255ebc25fa53767c9455b4053f3720f04007183de7dc7f9f48e2033339764ce7?placeholderIfAbsent=true&apiKey=9353569a3a3e4b28bd8525400308d314"
                                        alt="" class="meta-icon" />
                                    <span>12 flashcard</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
            <div class="col-lg-4">
                <article class="learning-card">
                    <div class="card-content">
                        <img src="https://cdn.builder.io/api/v1/image/assets/TEMP/5efdb3fc97a77f3e64de5f99bed465e16524949a979e8549bc861b1359500d53?placeholderIfAbsent=true&apiKey=9353569a3a3e4b28bd8525400308d314"
                            alt="" class="card-icon" />
                        <div class="card-details">
                            <h2 class="card-title">Kinh Doanh Quốc Tế</h2>
                            <div class="card-meta">
                                <div class="meta-item">
                                    <img src="https://cdn.builder.io/api/v1/image/assets/TEMP/10362e98450ec4e19b25c772a7aeda2bec76be0b1add1d3e7ef67bcee9279854?placeholderIfAbsent=true&apiKey=9353569a3a3e4b28bd8525400308d314"
                                        alt="" class="meta-icon" />
                                    <span>Có sẵn</span>
                                </div>
                                <div class="meta-item">
                                    <img src="https://cdn.builder.io/api/v1/image/assets/TEMP/255ebc25fa53767c9455b4053f3720f04007183de7dc7f9f48e2033339764ce7?placeholderIfAbsent=true&apiKey=9353569a3a3e4b28bd8525400308d314"
                                        alt="" class="meta-icon" />
                                    <span>3 flashcard</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
            <div class="col-lg-4">
                <article class="learning-card">
                    <div class="card-content">
                        <img src="/common/images/book.png" alt="" class="card-icon" />
                        <div class="card-details">
                            <h2 class="card-title">Thiết Kế Đồ Họa</h2>
                            <div class="card-meta">
                                <div class="meta-item">
                                    <img src="/common/images/folder.png" alt="" class="meta-icon" />
                                    <span>Có sẵn</span>
                                </div>
                                <div class="meta-item">
                                    <img src="/common/images/bookmark.png" alt="" class="meta-icon" />
                                    <span>1 flashcard</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </div>
    <h2 class="material-inside-title">Học liệu được ưa chuộng</h2>
    <div class="row">
    @{
        var courses = Model?.TakeLast(3).ToList(); // Lấy 3 phần tử cuối cùng
        int count = courses?.Count ?? 0; // Kiểm tra số lượng phần tử thực tế
    }

    @if (courses != null)
    {
        @foreach (var course in courses)
        {
            <div class="slider-item col-lg-4">
                <a href="#" text-decoration="none">
                    <img src="https://ununsplash.imgix.net/photo-1431578500526-4d9613015464?fit=crop&fm=jpg&h=300&q=75&w=400" 
                         alt="Course Image" style="width: 100%; height: auto;">
                    <p>@course.Description</p>
                </a>
            </div>
        }
    }

    @for (int i = count; i < 3; i++)
    {
        <div class="slider-item col-lg-4">
            <img src="https://ununsplash.imgix.net/photo-1431578500526-4d9613015464?fit=crop&fm=jpg&h=300&q=75&w=400" alt="Placeholder Image">
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
            <a href="#" class="btn-learning-custom">
                <img src="/common/images/save_outline.png" alt="Icon" />
                chưa có học liệu
            </a>
        </div>
    }
</div>

</div>

<div class="container comment-wrapper">
    <h2 class="material-inside-title comment-material-title">Bình luận</h2>
    <!-- Comment Box 1 -->
    <div class="comment-box">
        <div class="d-flex">
            <div class="comment-avatar"></div>
            <div class="ms-3 w-100">
                <div class="comment-header">Nguyễn Văn An</div>
                <div class="comment-body">
                   Khởi nghiệp trong lĩnh vực AI đang rất hot! Mọi người nghĩ sao về xu hướng này?
                </div>
                <div class="comment-meta">08:30 12/02/2025</div>
            </div>
        </div>


        <div class="d-flex mt-3">
            <div class="reply-box w-100">
               Đúng rồi! AI đang là xu hướng, nhưng để thành công thì cần nguồn vốn rất lớn.   <div class="reply-meta">04:52 28/06/2024</div>
            </div>
            <div class="comment-avatar ms-3"></div>
        </div>


        <div class="d-flex mt-4">
            <div class="comment-avatar"></div>
            <div class="ms-3 w-100">
                <div class="comment-header">Nguyễn Văn An</div>
                <div class="comment-body">
                  Theo mình, Blockchain cũng đang mở ra rất nhiều cơ hội cho các startup!   </div>
                <div class="comment-meta">09:10 12/02/2025</div>
            </div>


        </div>


        <div class="d-flex mt-3">
            <div class="reply-box w-100">
                 Đúng vậy! Nhiều startup Việt Nam đã gọi vốn thành công nhờ công nghệ này.
                <div class="reply-meta">09:25 12/02/2025</div>
            </div>
            <div class="comment-avatar ms-3"></div>
        </div>
        <div class="d-flex mt-4">
            <div class="comment-avatar"></div>
            <div class="ms-3 w-100">
                <div class="comment-header">Nguyễn Văn An</div>
                <div class="comment-body">
                    Blockchain chắc chắn là xu hướng lâu dài.
                </div>
                <div class="comment-meta">10:15 12/02/2025</div>
            </div>

        </div>
    </div>
</div>