@{
    ViewData["Title"] = "ModuleInformation";
    Layout = "/Views/Shared/_homepage-layout.cshtml";
}

<!-- Facebook SDK -->
<div id="fb-root"></div>
<div id="video-container">
    <div class="video-wrapper">
        <!-- Video sẽ hiển thị ở đây -->
    </div>
</div>

<div class="module-info">
    <h1>Lập trình C# cơ bản/h1>
        <p>Khóa học này giúp bạn nắm vững các khái niệm cơ bản về C#, từ cú pháp đến lập trình hướng đối tượng.</p>
</div>
<div class="button-group">
    <a asp-action="AllModule" class="big-button back-button">⬅ Quay lại</a>
    <a class="big-button submit-button">📤 Nộp bài</a>
</div>
<style>
    .module-info {
        max-width: 800px;
        margin: 20px auto;
        padding: 20px;
        background: white;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .module-info h1 {
        font-size: 28px;
        color: #333;
    }

    .module-info p {
        font-size: 18px;
        color: #555;
        line-height: 1.6;
    }

    /* Định dạng nút */
    .button-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        margin: 40px 0;
    }

    .big-button {
        width: 80%;
        max-width: 400px;
        padding: 15px;
        font-size: 20px;
        font-weight: bold;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
    }

    .back-button {
        background-color: #007bff;
        color: white;
    }

    .back-button:hover {
        background-color: #0056b3;
    }

    .submit-button {
        background-color: #28a745;
        color: white;
    }

    .submit-button:hover {
        background-color: #218838;
    }

    #video-container {
        width: 100%;
        max-width: 800px;
        height: 500px;
        /* Chiều cao cố định */
        margin: 20px auto;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 1px solid #ddd;
        background: black;
        /* Nền đen nếu video không fit */
        overflow: hidden;
        position: relative;
    }

    .video-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 100%;
    }

    iframe {
        width: 100%;
        height: 100%;
    }

    /* Facebook Reel - Tỷ lệ dọc 9:16 */
    .reel-container {
        position: absolute;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .reel-container iframe {
        width: auto;
        /* Chiều rộng tự động */
        height: 100%;
        aspect-ratio: 9 / 16;
        max-height: 100%;
    }

    .reel-note {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.6);
        color: white;
        font-size: 12px;
        padding: 5px 10px;
        border-radius: 5px;
        text-align: center;
        white-space: nowrap;
    }
</style>

<!-- Instagram SDK -->
<script async src="https://www.instagram.com/embed.js"></script>

<script>
    function loadVideo(videoUrl) {
        let container = document.querySelector(".video-wrapper");
        container.innerHTML = ""; // Xóa nội dung cũ

        if (!videoUrl) {
            container.innerHTML = "<p>Vui lòng nhập URL video.</p>";
            return;
        }

        if (videoUrl.includes("youtube.com") || videoUrl.includes("youtu.be")) {
            // Xử lý YouTube
            let videoId = videoUrl.split("v=")[1]?.split("&")[0] || videoUrl.split("/").pop();
            let embedUrl = `https://www.youtube.com/embed/${videoId}`;
            container.innerHTML = `<iframe src="${embedUrl}" frameborder="0" allowfullscreen></iframe>`;
        }
        else if (videoUrl.includes("facebook.com/watch")) {
            // Facebook Watch giữ nguyên (16:9)
            let embedUrl = `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(videoUrl)}&show_text=0`;
            container.innerHTML = `<iframe src="${embedUrl}" frameborder="0" allowfullscreen></iframe>`;
        }
        else if (videoUrl.includes("facebook.com/reel")) {
            // Facebook Reel - Fix hiển thị đúng 9:16
            let embedUrl = `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(videoUrl)}&show_text=0`;
            container.innerHTML = `<div class="reel-container"><iframe src="${embedUrl}" frameborder="0" allowfullscreen></iframe></div>`;
            container.innerHTML = `
                <div class="reel-container">
                    <iframe src="${embedUrl}" frameborder="0" allowfullscreen></iframe>
                    <p class="reel-note">📢 Đối với video Reel, bạn nên phóng to để xem rõ hơn!</p>
                </div>
            `;
        }
        else if (videoUrl.includes("instagram.com/reel") || videoUrl.includes("instagram.com/p/")) {
            // Xử lý Instagram Reel
            container.innerHTML = `<blockquote class="instagram-media" data-instgrm-permalink="${videoUrl}" data-instgrm-version="14"></blockquote>`;
            instgrm.Embeds.process(); // Load lại Instagram SDK
        }
        else {
            container.innerHTML = "<p>URL không hợp lệ hoặc không được hỗ trợ.</p>";
        }
    

    // 💡 Thay link này để hiển thị video mong muốn
    let videoUrl = "https://www.youtube.com/watch?v=LXl_am_35Bs"; // Thay bằng link của bạn
    loadVideo(videoUrl);
</script>
