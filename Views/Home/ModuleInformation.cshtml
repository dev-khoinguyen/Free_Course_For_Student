@{
    ViewData["Title"] = "ModuleInformation";
    Layout = "/Views/Shared/_homepage-layout.cshtml";
}
@model EXE_PROJECT.Models.Module

<!-- Facebook SDK -->
<div id="fb-root"></div>

<!-- Instagram SDK -->
<script async src="https://www.instagram.com/embed.js"></script>

<div id="video-container">
    <div class="video-wrapper"></div>
</div>
@* content and title  *@
<div class="module-info">
    <h1>@Model.Title</h1>
    <p>@Model.Description</p>
</div>
<div class="button-group">
    @if (!string.IsNullOrEmpty(Model.DocUrl))
    {
        <a href="@Model.DocUrl" target="_blank" class="big-button resource-button">📚 Tài nguyên</a>
    }
    else
    {
        <span class="no-resource">🚫 Chưa có tài nguyên</span>
    }
    <a asp-action="ClientSubmission" asp-controller="Home" asp-route-itemid="@Model.ModuleId" class="big-button submit-button">📤 Nộp bài</a>
    <a asp-action="AllModule" asp-controller="Home" asp-route-id="@Model.CourseId" class="big-button back-button">⬅ Quay
        lại</a>
</div>
<style>
    #video-container {
        width: 100%;
        max-width: 800px;
        height: 500px;
        margin: 20px auto;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 1px solid #ddd;
        background: black;
        overflow: hidden;
        position: relative;
    }

    .video-wrapper {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    iframe {
        width: 100%;
        height: 100%;
    }

    .reel-container {
        position: absolute;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .reel-container iframe {
        width: auto;
        height: 100%;
        aspect-ratio: 9 / 16;
    }

    .reel-note {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.6);
        color: white;
        font-size: 12px;
        padding: 5px 10px;
        border-radius: 5px;
        text-align: center;
        white-space: nowrap;
    }

    .button-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        margin: 40px 0;
    }

    .big-button {
        display: inline-block;
        width: 80%;
        max-width: 400px;
        text-align: center;
        padding: 15px;
        font-size: 20px;
        font-weight: bold;
        border-radius: 8px;
        text-decoration: none;
        transition: 0.3s;
    }

    .back-button {
        background-color: #007bff;
        color: white;
    }

    .back-button:hover {
        background-color: #0056b3;
    }

    .submit-button {
        background-color: #28a745;
        color: white;
    }

    .submit-button:hover {
        background-color: #218838;

    }

    .module-info {
        max-width: 800px;
        margin: 20px auto;
        padding: 20px;
        text-align: center;
        background: #f9f9f9;
        border-radius: 8px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .module-info h1 {
        font-size: 28px;
        color: #333;
        margin-bottom: 10px;
    }

    .module-info p {
        font-size: 18px;
        color: #666;
        line-height: 1.5;
    }

    .resource-button {
        background: #ffc107;
        color: rgb(255, 255, 255);
        text-decoration: none;
        transition: 0.3s;
        display: inline-block;
    }

    .resource-button:hover {
        background: #e0a800;
    }

    .no-resource {
        color: #999;
        font-size: 14px;
        font-style: italic;
        margin-left: 10px;
    }
</style>



<script>
    function loadVideo(videoUrl) {
        let container = document.querySelector(".video-wrapper");
        container.innerHTML = "";

        if (!videoUrl) {
            container.innerHTML = "<p>Vui lòng nhập URL video.</p>";
            return;
        }

        if (videoUrl.includes("youtube.com") || videoUrl.includes("youtu.be")) {
            let videoId = videoUrl.split("v=")[1]?.split("&")[0] || videoUrl.split("/").pop();
            let embedUrl = `https://www.youtube.com/embed/${videoId}`;
            container.innerHTML = `<iframe src="${embedUrl}" frameborder="0" allowfullscreen></iframe>`;
        }
        else if (videoUrl.includes("facebook.com/watch")) {
            let embedUrl = `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(videoUrl)}&show_text=0`;
            container.innerHTML = `<iframe src="${embedUrl}" frameborder="0" allowfullscreen></iframe>`;
        }
        else if (videoUrl.includes("facebook.com/reel")) {
            let embedUrl = `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(videoUrl)}&show_text=0`;
            container.innerHTML = `
                <div class="reel-container">
                    <iframe src="${embedUrl}" frameborder="0" allowfullscreen></iframe>
                    <p class="reel-note">📢 Đối với video Reel, bạn nên phóng to để xem rõ hơn!</p>
                </div>
            `;
        }
        else if (videoUrl.includes("instagram.com/reel") || videoUrl.includes("instagram.com/p/")) {
            container.innerHTML = `<blockquote class="instagram-media" data-instgrm-permalink="${videoUrl}" data-instgrm-version="14"></blockquote>`;
            setTimeout(() => instgrm.Embeds.process(), 500);
        }
        else {
            container.innerHTML = "<p>URL không hợp lệ hoặc không được hỗ trợ.</p>";
        }
    }

    let videoUrl = "@Model.VideoUrl";
    loadVideo(videoUrl);
</script>
