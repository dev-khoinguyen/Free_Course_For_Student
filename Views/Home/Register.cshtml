@{
    ViewData["Title"] = "Register";
    Layout = "/Views/Shared/_homepage-layout.cshtml";
}
@model User

<div class="regis-bg-blue">
    <div class="regis-container">
        <div class="text-center mb-4">
            <h2 class="regis-title">Đăng Ký</h2>
        </div>
        <form asp-action="Register" asp-controller="home" method="post">
            <div class="form-group regis-input">
                <input asp-for="Username" class="form-control" placeholder="Tên đăng nhập">
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="form-group regis-input">
                <input asp-for="Email" class="form-control" placeholder="Email">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group regis-input">
                <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Mật khẩu">
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
            </div>
            <div class="form-group regis-input">
                <input asp-for="Role" type="hidden" class="form-control" value="User">
            </div>
            <button type="submit" class="regis-button">Đăng ký</button>
        </form>
    </div>
</div>
