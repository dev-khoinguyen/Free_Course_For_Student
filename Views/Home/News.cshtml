            </nav>


        </div>

        <div class="col-lg-3">
            <div class="container-news">
                <div class="image-news">
                </div>
                <h3 class="title-news">Tin Tức Phổ biến</h3>
                <ul class="list-news">
                    <li class="item-news">
                        <span class="number-news">1</span>
                        <span class="text-news">Startup AI Việt Nam nhận đầu tư 20 triệu USD từ quỹ nước ngoài</span>
                    </li>
                    <li class="item-news">
                        <span class="number-news">2</span>
                        <span class="text-news">Blockchain mở ra cơ hội mới cho doanh nghiệp khởi nghiệp
                        </span>
                    </li>
                    <li class="item-news">
                        <span class="number-news">3</span>
                        <span class="text-news">Công nghệ xanh - Xu hướng startup bền vững năm 2024</span>
