@model EXE_PROJECT.Models.ProfileViewModel

@{
    ViewData["Title"] = "ClientProfile";
    Layout = "/Views/Shared/_homepage-layout.cshtml";
}

<div class="container mt-5">
    <!-- Tabs -->
    <div class="nav-icons">
        <a href="#" class="active" onclick="changeTab(event, 'profile')">Thông tin tài khoản</a>
        <a href="#" onclick="changeTab(event, 'courses')">Các khóa học</a>
        <a href="#" onclick="changeTab(event, 'submissions')">Bài nộp</a>
    </div>

    <!-- Thông tin cá nhân -->
    <div id="profile" class="content active">
        <div class="information-card">
            <div class="text-center mb-4">
                <p class="font-weight-bold">Ảnh đại diện</p>
                <img class="information-profile-pic" height="100"
                    src="https://storage.googleapis.com/a1aa/image/VR_nnWwcQ3FmfiAEsUPA-2z5RFR6kQzjJMTCoeRoYM4.jpg"
                    width="100" />
            </div>
            <div class="border p-4 rounded">
                <h2 class="information-section-title">Thông tin cá nhân</h2>
                <div class="form-row">
                    <div class="form-group">
                        <label>Họ và tên</label>
                        <input readonly class="form-control" type="text" value="@Model.User.Username" />
                    </div>
                    <div class="form-group">
                        <label>Địa chỉ email</label>
                        <input readonly class="form-control" type="email" value="@Model.User.Email" />
                    </div>
                    <div class="form-group">
                        <label>Vai trò</label>
                        <input readonly class="form-control" type="text" value="@Model.User.Role" />
                    </div>
                    <div class="form-group">
                        <label>Ngày tạo tài khoản</label>
                        <input readonly class="form-control" type="text"
                            value="@Model.User.CreatedAt?.ToString("dd/MM/yyyy")" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Danh sách khóa học -->
<div id="courses" class="content">
    <ul class="list-group">
        @if (Model != null && Model.UserCourses != null && Model.UserCourses.Any())
        {
            @foreach (var userCourse in Model.UserCourses)
            {
                @if (userCourse.Course != null) // Kiểm tra tránh lỗi null
                {
                    var progress = (userCourse.AllModule > 0) ? ((double)(userCourse.FinishedModule ?? 0) /
                    userCourse.AllModule.Value * 100) : 0;

                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="w-75"> <!-- Giới hạn chiều rộng của nội dung -->
                            <strong>@userCourse.Course.Title</strong>
                            <p class="text-muted mb-1">Ngày tham gia:
                                @(userCourse.EnrolledAt?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")
                            </p>

                            <!-- Thanh tiến độ nhỏ hơn -->
                            <div class="progress mt-2" style="height: 14px;; width: 100%;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"                    
                                      role="progressbar" style="width: @progress%;" aria-valuenow="@progress"          
                                    aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                            <small>@progress.ToString("0")% hoàn thành</small>
                        </div>

                        <a href="CourseInformation/@userCourse.Course.Id" class="btn btn-primary">
                            Xem chi tiết
                        </a>
                    </li>
                }
                else
                {
                    <li class="list-group-item">Dữ liệu khóa học không tồn tại.</li>
                }
            }
        }
        else
        {
            <li class="list-group-item">Bạn chưa tham gia khóa học nào.</li>
        }
    </ul>
</div>




<!-- Danh sách bài nộp -->
<div id="submissions" class="content">
    <div class="card shadow-sm">
        <div class="card-body">
            <h3 class="text-center">Danh sách bài nộp và điểm</h3>
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Submission URL</th>
                            <th>Score</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Submissions.Any())
                        {
                            @foreach (var submission in Model.Submissions)
                            {
                                <tr>
                                    <td>
                                        @if
                                                                        (!string.IsNullOrEmpty(submission.SubmissionUrl))
                                        {
                                            <a href="@submission.SubmissionUrl" target="_blank">Xem bài nộp</a>
                                        }
                                        else
                                        {
                                            <span>Chưa có</span>
                                        }
                                </td>
                                <td>
                                    @(submission.Score.HasValue ?
                                                                    submission.Score.Value.ToString("0.00") : "Chưa có")
                                </td>
                                <td>@submission.Status</td>
                            </tr>
                                                }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center">Bạn chưa có bài nộp nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<style>
    .content {
        opacity: 0;
        transform: translateX(100%);
        transition: transform 0.5s ease-in-out, opacity 0.5s ease-in-out;
        position: absolute;
        width: 100%;
        top: 0;
        left: 0;
        visibility: hidden;
    }

    .content.active {
        position: relative;
        opacity: 1;
        transform: translateX(0);
        visibility: visible;
    }
</style>

<script>
    function changeTab(event, tabId) {
        event.preventDefault();

        document.querySelectorAll('.nav-icons a').forEach(el => el.classList.remove('active'));
        event.target.classList.add('active');

        document.querySelectorAll('.content').forEach(el => {
            el.classList.remove('active');
        });

        let activeTab = document.getElementById(tabId);
        activeTab.classList.add('active');
    }

    function showDetails(course) {
        let details = {
            html: { title: "Khóa học HTML", progress: 75, content: "Học HTML từ cơ bản đến nâng cao." },
            css: { title: "Khóa học CSS", progress: 50, content: "Khám phá CSS và cách tạo giao diện đẹp." }
        };

        let courseData = details[course];
        document.getElementById("courseInfo").innerHTML = `<h4>${courseData.title}</h4><p>${courseData.content}</p><p>Tiến độ: ${courseData.progress}% hoàn thành.</p>`;

        let progressBar = document.getElementById("progressBar");
        progressBar.style.width = courseData.progress + "%";
        progressBar.innerText = courseData.progress + "%";
    }
</script>
