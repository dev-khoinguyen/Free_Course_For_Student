@{
    ViewData["Title"] = "ClientProfile";
    Layout = "/Views/Shared/_homepage-layout.cshtml";
}
<div class="container information-container">


    <div class="nav-icons">
        <a href="#" class="active" onclick="changeActive(event, 'allCourses')">Các khóa học</a>
        <a href="#" onclick="changeActive(event, 'courseDetails')">Thông tin khóa học</a>
    </div>

    <div class="container mt-5">
        <div id="allCourses" class="content active">
            <h2 class="text-center mb-4">Danh sách các khóa học</h2>
            <ul class="list-group">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Khóa học HTML <a href="#" class="btn-view" onclick="showDetails('html')">Xem chi tiết</a>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Khóa học CSS <a href="#" class="btn-view" onclick="showDetails('css')">Xem chi tiết</a>
                </li>
            </ul>
        </div>

        <div id="courseDetails" class="content">
            <h2 class="text-center mb-4">Thông tin khóa học</h2>
            <div id="courseInfo">
                <p>Chọn một khóa học để xem thông tin chi tiết.</p>
            </div>
            <div class="progress mt-3">
                <div id="progressBar" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0"
                    aria-valuemin="0" aria-valuemax="100">0%</div>
            </div>
        </div>
    </div>

    <script>
        function changeActive(event, sectionId) {
            event.preventDefault();
            document.querySelectorAll('.nav-icons a').forEach(el => el.classList.remove('active'));
            event.target.classList.add('active');

            document.querySelectorAll('.content').forEach(el => el.classList.remove('active'));
            document.getElementById(sectionId).classList.add('active');
        }

        function showDetails(course) {
            changeActive(event, 'courseDetails');
            let details = {
                html: { title: "Khóa học HTML", progress: 75, content: "Học HTML từ cơ bản đến nâng cao." },
                css: { title: "Khóa học CSS", progress: 50, content: "Khám phá CSS và cách tạo giao diện đẹp." }
            };

            let courseData = details[course];
            document.getElementById("courseInfo").innerHTML = `<h4>${courseData.title}</h4><p>${courseData.content}</p><p>Tiến độ: ${courseData.progress}% hoàn thành.</p>`;

            let progressBar = document.getElementById("progressBar");
            progressBar.style.width = courseData.progress + "%";
            progressBar.innerText = courseData.progress + "%";
        }
    </script>


    <div class="information-card">
        <div class="information-tab">
            <button>
                Thông tin tài khoản
            </button>
        </div>
        <div class="text-center mb-4">
            <p class="font-weight-bold">
                Ảnh đại diện
            </p>
            <img alt="Profile picture placeholder" class="information-profile-pic" height="100"
                src="https://storage.googleapis.com/a1aa/image/VR_nnWwcQ3FmfiAEsUPA-2z5RFR6kQzjJMTCoeRoYM4.jpg"
                width="100" />

        </div>
        <div class="border p-4 rounded">
            <h2 class="information-section-title">
                Thông tin cá nhân
            </h2>
            <div class="form-row">
                <div class="form-group">
                    <label for="information-name">
                        Họ và tên
                    </label>
                    <input readonly class="form-control" id="information-name" type="text" value="" />
                </div>
                <div class="form-group">
                    <label for="information-phone">
                        Số điện thoại
                    </label>
                    <input readonly class="form-control" id="information-phone" type="text" value="08253275235" />
                </div>
                <div class="form-group">
                    <label for="information-email">
                        Địa chỉ email
                    </label>
                    <input readonly class="form-control" id="information-email" type="email" value="" />
                </div>
                <div class="form-group">
                    <label for="information-gender">
                        Giới tính
                    </label>
                    <select class="form-control" id="information-gender">
                        <option>
                            Nam
                        </option>
                        <option>
                            Nữ
                        </option>
                        <option>
                            Khác
                        </option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="information-dob">
                        Ngày sinh
                    </label>
                    <input readonly class="form-control" id="information-dob" placeholder="01/05/2003" type="text" />
                </div>
                <div class="form-group">
                    <label for="information-address">
                        Địa chỉ chi tiết
                    </label>
                    <input readonly class="form-control" id="information-address" type="text"
                        value="Mỹ Xuyên, Sóc Trăng" />
                </div>
            </div>
        </div>
    </div>

</div>
