@{
    ViewData["Title"] = "Information";
    Layout = "/Views/Shared/_homepage-layout.cshtml";
}

<div class="container information-container">
    <div class="information-card">
        <div class="information-tab">
            <button>
                Thông tin tài khoản
            </button>
        </div>
        <div class="text-center mb-4">
            <p class="font-weight-bold">
                Ảnh đại diện
            </p>
            <img alt="Profile picture placeholder" class="information-profile-pic" height="100"
                src="https://storage.googleapis.com/a1aa/image/VR_nnWwcQ3FmfiAEsUPA-2z5RFR6kQzjJMTCoeRoYM4.jpg"
                width="100" />
            <div>
                <button class="information-edit-btn">
                    <i class="fas fa-user-edit">
                    </i>
                    Chỉnh sửa
                </button>
            </div>
        </div>
        <div class="border p-4 rounded">
            <h2 class="information-section-title">
                Thông tin cá nhân
            </h2>
            <div class="form-row">
                <div class="form-group">
                    <label for="information-name">
                        Họ và tên
                    </label>
                    <input class="form-control" id="information-name" type="text" value="Nguyễn Thanh Nhàn" />
                </div>
                <div class="form-group">
                    <label for="information-phone">
                        Số điện thoại
                    </label>
                    <input class="form-control" id="information-phone" type="text" value="xxxxxxxxx" />
                </div>
                <div class="form-group">
                    <label for="information-email">
                        Địa chỉ email
                    </label>
                    <input class="form-control" id="information-email" type="email" value="ng........" />
                </div>
                <div class="form-group">
                    <label for="information-gender">
                        Giới tính
                    </label>
                    <select class="form-control" id="information-gender">
                        <option>
                            Nam
                        </option>
                        <option>
                            Nữ
                        </option>
                        <option>
                            Khác
                        </option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="information-dob">
                        Ngày sinh
                    </label>
                    <input class="form-control" id="information-dob" placeholder="dd/mm/yyyy" type="text" />
                </div>
                <div class="form-group">
                    <label for="information-address">
                        Địa chỉ chi tiết
                    </label>
                    <input class="form-control" id="information-address" type="text" value="Mỹ Xuyên, Sóc Trăng" />
                </div>
            </div>
            <div class="text-right">
                <button class="information-update-btn">
                    <i class="fas fa-sync-alt">
                    </i>
                    Cập nhật
                </button>
            </div>
        </div>
    </div>
</div>