@{
    ViewData["Title"] = "Index";
    Layout = "/Views/Shared/_admin-layout.cshtml";
}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card text-bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Tổng số khóa học</h5>
                    <p class="card-text fs-3">12</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-success">
                <div class="card-body">
                    <h5 class="card-title">Học viên đã đăng ký</h5>
                    <p class="card-text fs-3">350</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Lượt học hoàn thành</h5>
                    <p class="card-text fs-3">120</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 p-4 bg-light rounded">
        <h3>Giới thiệu về E-Learning Khởi Nghiệp</h3>
        <p>Chào mừng bạn đến với nền tảng E-Learning dành cho học sinh vùng xa. Chúng tôi cung cấp các khóa học khởi
            nghiệp giúp các bạn trang bị kiến thức và kỹ năng cần thiết để phát triển ý tưởng kinh doanh. Hệ thống hỗ
            trợ học trực tuyến, bài giảng đa dạng và đội ngũ giảng viên giàu kinh nghiệm.</p>
        <p>Hãy khám phá và bắt đầu hành trình học tập ngay hôm nay!</p>
    </div>
</div>