@{
    ViewData["Title"] = "CourseManagement";
    Layout = "/Views/Shared/_admin-layout.cshtml";
}
<script>
        function editCourse(id, title, description, groupChatURL) {
            document.querySelector("input[name='id']").value = id;
            document.querySelector("input[name='title']").value = title;
            document.querySelector("textarea[name='description']").value = description;
            document.querySelector("input[name='groupChatURL']").value = groupChatURL;
        }
    </script>
<div class="container container--course">
        <h2 class="title--course">Thêm/Sửa khóa học</h2>
        
        <!-- Form thêm/sửa khóa học -->
        <div class="card card--course">
            <div class="card-body">
                <h5 class="card-title"></h5>
                <form method="post" action="/Courses/Save">
                    <input type="hidden" name="id">
                    <div class="mb-3">
                        <label class="form-label form-label--course">Tiêu đề</label>
                        <input type="text" name="title" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label form-label--course">Mô tả</label>
                        <textarea name="description" class="form-control" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label form-label--course">URL nhóm</label>
                        <input type="url" name="groupChatURL" class="form-control">
                    </div>
                    <button type="submit" class="btn btn-primary btn--course">Lưu</button>
                </form>
            </div>
        </div>
        
        <!-- Bảng danh sách khóa học -->
        <table class="table table-bordered table--course">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tiêu đề</th>
                    <th>Mô tả</th>
                    <th>URL Nhóm</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>Khóa học HTML & CSS</td>
                    <td>Học cách tạo giao diện web bằng HTML và CSS</td>
                    <td><a href="https://chat.example.com/html-css" target="_blank">Link</a></td>
                    <td>
                        <button type="button" class="btn btn-warning btn-sm btn--course" onclick="editCourse('1', 'Khóa học HTML & CSS', 'Học cách tạo giao diện web bằng HTML và CSS', 'https://chat.example.com/html-css')">Sửa</button>
                        <a href="#" class="btn btn-danger btn-sm btn--course" onclick="return confirm('Bạn có chắc chắn muốn xóa?');">Xóa</a>
                        <a href="#" class="btn btn-info btn-sm btn--course">Quản lý Module</a>
                    </td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>Khóa học JavaScript</td>
                    <td>Học lập trình JavaScript cơ bản đến nâng cao</td>
                    <td><a href="https://chat.example.com/javascript" target="_blank">Link</a></td>
                    <td>
                        <button type="button" class="btn btn-warning btn-sm btn--course" onclick="editCourse('2', 'Khóa học JavaScript', 'Học lập trình JavaScript cơ bản đến nâng cao', 'https://chat.example.com/javascript')">Sửa</button>
                        <a href="#" class="btn btn-danger btn-sm btn--course" onclick="return confirm('Bạn có chắc chắn muốn xóa?');">Xóa</a>
                        <a href="#" class="btn btn-info btn-sm btn--course">Quản lý Module</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
