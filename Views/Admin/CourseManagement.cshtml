@model List<EXE_PROJECT.Models.Course>

@{
    ViewData["Title"] = "CourseManagement";
    Layout = "/Views/Shared/_admin-layout.cshtml";
}

<!-- Cập nhật CKEditor lên phiên bản mới nhất -->
<script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (document.getElementById("Description")) {
            CKEDITOR.replace('Description');
        }
    });

    function editCourse(id, title, description, groupChatURL) {
        document.querySelector("input[name='Id']").value = id;
        document.querySelector("input[name='Title']").value = title;
        document.querySelector("input[name='GroupChatUrl']").value = groupChatURL;

        if (CKEDITOR.instances['Description']) {
            CKEDITOR.instances['Description'].setData(description);
        } else {
            document.getElementById("Description").value = description;
        }
    }
</script>
<style>
    .cke_notification {
        display: none !important;
    }
</style>


<div class="container container--course">
    <h2 class="title--course">Thêm/Sửa khóa học</h2>

    <div class="card card--course">
        <div class="card-body">
            <form method="post" action="/Admin/course/save">
                <input type="hidden" name="Id">
                <div class="mb-3">
                    <label class="form-label form-label--course">Tiêu đề</label>
                    <input type="text" name="Title" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label form-label--course">Mô tả</label>
                    <textarea name="Description" id="Description" class="form-control" required></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label form-label--course">URL nhóm</label>
                    <input type="url" name="GroupChatUrl" class="form-control">
                </div>
                <button type="submit" class="btn btn-primary btn--course">Lưu</button>
            </form>
        </div>
    </div>

    <table class="table table-bordered table--course">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tiêu đề</th>
                <th>Mô tả</th>
                <th>URL Nhóm</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.Id</td>
                    <td>@course.Title</td>
                    <td>@Html.Raw(course.Description)</td> <!-- Hiển thị HTML đúng cách -->
                    <td>
                        @if (!string.IsNullOrEmpty(course.GroupChatUrl))
                        {
                            <a href="@course.GroupChatUrl" target="_blank">Link</a>
                        }
                    </td>
                    <td>
                        <button type="button" class="btn btn-warning btn-sm btn--course"
                            onclick="editCourse('@course.Id', '@course.Title', `@Html.Raw(course.Description)`, '@course.GroupChatUrl')">
                            Sửa
                        </button>
                        <form method="post" action="/Admin/course/delete/@course.Id" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm btn--course"
                                onclick="return confirm('Bạn có chắc chắn muốn xóa?');">
                                Xóa
                            </button>
                        </form>
                        <a href="/Admin/module-management/@course.Id" class="btn btn-info btn-sm">
                            Quản lý Module
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
