@{
    ViewData["Title"] = "ModuleManagement";
    Layout = "/Views/Shared/_admin-layout.cshtml";
}

<script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (document.querySelector("textarea[name='Description']")) {
            CKEDITOR.replace('Description');
        }
    });

    function editModule(id, title, position, docURL, videoURL, description, isFinished) {
        document.querySelector("input[name='ModuleId']").value = id;
        document.querySelector("input[name='Title']").value = decodeURIComponent(title);
        document.querySelector("input[name='Position']").value = position;
        document.querySelector("input[name='DocUrl']").value = decodeURIComponent(docURL);
        document.querySelector("input[name='VideoUrl']").value = decodeURIComponent(videoURL);
        document.querySelector("select[name='IsFinished']").value = isFinished;

        if (CKEDITOR.instances['Description']) {
            CKEDITOR.instances['Description'].setData(decodeURIComponent(description));
        } else {
            document.querySelector("textarea[name='Description']").value = decodeURIComponent(description);
        }
    }
</script>

<style>
    .cke_notification {
        display: none !important;
    }
</style>

<div class="container">
    <h2>Quản lý Module</h2>

    <!-- Form thêm/sửa module -->
    <div class="card">
        <div class="card-body">
            <form method="post" action="/Admin/save-module">
                <input type="hidden" name="ModuleId">
                <input type="hidden" name="CourseId" value="@ViewBag.CourseId">

                <div class="mb-3">
                    <label class="form-label">Tiêu đề</label>
                    <input type="text" name="Title" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Vị trí</label>
                    <input type="number" name="Position" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Tài liệu URL</label>
                    <input type="url" name="DocUrl" class="form-control">
                </div>
                <div class="mb-3">
                    <label class="form-label">Video URL</label>
                    <input type="url" name="VideoUrl" class="form-control">
                </div>
                <div class="mb-3">
                    <label class="form-label">Mô tả</label>
                    <textarea name="Description" class="form-control"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Hoàn thành</label>
                    <select name="IsFinished" class="form-control">
                        <option value="false">Chưa hoàn thành</option>
                        <option value="true">Đã hoàn thành</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Lưu</button>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách module -->
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tiêu đề</th>
                <th>Vị trí</th>
                <th>Tài liệu</th>
                <th>Video</th>
                <th>Mô tả</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var module in Model)
            {
                <tr>
                    <td>@module.ModuleId</td>
                    <td>@module.Title</td>
                    <td>@module.Position</td>
                    <td><a href="@module.DocUrl" target="_blank">Tài liệu</a></td>
                    <td><a href="@module.VideoUrl" target="_blank">Video</a></td>
                    <td>@Html.Raw(module.Description)</td>
                    <td>@(module.IsFinished == true ? "Đã hoàn thành" : "Chưa hoàn thành")</td>
                    <td>
                        <button type="button" class="btn btn-warning btn-sm" onclick="editModule(
                '@module.ModuleId', 
                '@Html.Raw(Uri.EscapeDataString(module.Title))', 
                '@module.Position', 
                '@Html.Raw(Uri.EscapeDataString(module.DocUrl ?? ""))', 
                '@Html.Raw(Uri.EscapeDataString(module.VideoUrl ?? ""))', 
                '@Html.Raw(Uri.EscapeDataString(module.Description ?? ""))', 
                '@module.IsFinished'
            )">
                            Sửa
                        </button>

                        <form method="post" action="/Admin/delete-module/@module.ModuleId" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Bạn có chắc chắn muốn xóa?');">
                                Xóa
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
