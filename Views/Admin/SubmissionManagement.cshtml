@{
    ViewData["Title"] = "SubmissionManagement";
    Layout = "/Views/Shared/_admin-layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Submission Management</h2>
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>User ID</th>
                <th>Module ID</th>
                <th>Submission URL</th>
                <th>Score</th>
                <th>Submitted At</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var submission in Model)
            {
                <tr>
                    <td>@submission.SubmissionId</td>
                    <td>@submission.UserId</td>
                    <td>@submission.ModuleId</td>
                    <td><a href="@submission.SubmissionUrl" class="text-primary" target="_blank">View</a></td>
                    <td>
                        <input type="number" class="form-control score-input" data-id="@submission.SubmissionId"
                               value="@submission.Score" min="0" max="100">
                    </td>
                    <td>@submission.SubmittedAt?.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge @(submission.Status == "Approved" ? "bg-success" : "bg-warning")">
                            @submission.Status
                        </span>
                    </td>
                    <td>
                        <form method="post" action="/Admin/delete-submission/@submission.SubmissionId" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".score-input").forEach(input => {
            input.addEventListener("change", function () {
                let submissionId = this.getAttribute("data-id");
                let score = this.value;

                fetch(`/Admin/update-submission`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ SubmissionId: submissionId, Score: score })
                }).then(response => {
                    if (response.ok) alert("Cập nhật điểm thành công!");
                });
            });
        });
    });
</script>
